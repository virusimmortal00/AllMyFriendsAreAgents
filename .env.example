# Existing JSON persistence remains the default during the storage migration.
ALL_MY_FRIENDS_ARE_AGENTS_STORAGE_BACKEND=json

# Override this to keep runtime data outside the Git checkout or mount /data in a container.
# ALL_MY_FRIENDS_ARE_AGENTS_DATA_DIR=/data
# Assignment Git worktrees must live outside the source checkout. Relative paths
# resolve beside the checkout; mount this path on durable storage in containers.
# ALL_MY_FRIENDS_ARE_AGENTS_ASSIGNMENT_WORKTREES_DIR=/data/assignment-worktrees

# Opt-in SQLite configuration.
# ALL_MY_FRIENDS_ARE_AGENTS_STORAGE_BACKEND=sqlite
# ALL_MY_FRIENDS_ARE_AGENTS_SQLITE_PATH=/data/amfaa.sqlite

# PostgreSQL configuration is reserved for the upcoming adapter. Never commit a real credential.
# ALL_MY_FRIENDS_ARE_AGENTS_STORAGE_BACKEND=postgres
# DATABASE_URL=postgresql://amfaa_app:change-me@postgres.example.test/amfaa

# Optional isolated development ports.
# ALL_MY_FRIENDS_ARE_AGENTS_WEB_PORT=4174
# ALL_MY_FRIENDS_ARE_AGENTS_PORT=53148
# Comma-separated hostnames accepted by both the Vite tunnel/reverse proxy and
# the MCP Host/Origin DNS-rebinding guards. Do not include schemes or ports.
# ALL_MY_FRIENDS_ARE_AGENTS_ALLOWED_HOSTS=agents.example.test
# Optional identity used when the local developer-agent bridge posts to the room.
# ALL_MY_FRIENDS_ARE_AGENTS_DEVELOPER_NAME=Developer Agent
# Optional explicit bridge token (minimum 32 characters). By default the server
# creates a private token in the configured data directory.
# ALL_MY_FRIENDS_ARE_AGENTS_DEVELOPER_TOKEN=
# Optional, default-off scoped GitHub contribution broker. Grant GITHUB_* capabilities
# explicitly in ALL_MY_FRIENDS_ARE_AGENTS_DEVELOPER_TEAM_JSON.
# ALL_MY_FRIENDS_ARE_AGENTS_GITHUB_REPOSITORY=owner/repository
# ALL_MY_FRIENDS_ARE_AGENTS_GITHUB_TOKEN=
# ALL_MY_FRIENDS_ARE_AGENTS_GITHUB_BASE_BRANCH=main
# Optional strictly read-only room-command GitHub binding. Create a fine-grained
# token for exactly one repository with only Metadata, Actions, Checks, Contents,
# Issues, and Pull requests read access; grant no write/admin permission. Never
# reuse ALL_MY_FRIENDS_ARE_AGENTS_GITHUB_TOKEN or another contribution/mutation
# credential. _FAKE is test/development-only and must remain empty in production.
ALL_MY_FRIENDS_ARE_AGENTS_GITHUB_READ_TOKEN=
ALL_MY_FRIENDS_ARE_AGENTS_GITHUB_READ_REPOSITORY=
ALL_MY_FRIENDS_ARE_AGENTS_GITHUB_READ_DEFAULT_BRANCH=
ALL_MY_FRIENDS_ARE_AGENTS_GITHUB_READ_FAKE=
# Optional exact deployment executor used only after a separate single-use approval.
# ALL_MY_FRIENDS_ARE_AGENTS_DEPLOYMENT_EXECUTOR_URL=
# ALL_MY_FRIENDS_ARE_AGENTS_DEPLOYMENT_EXECUTOR_TOKEN=
# Single-use local-operator proof for claiming the durable server OWNER identity.
# Use at least 32 random characters. It is never stored in room state or sent to a harness.
# Existing and fresh rooms remain fail-closed for roster/provider configuration until claimed.
# ALL_MY_FRIENDS_ARE_AGENTS_OWNER_BOOTSTRAP_SECRET=

# Override the OpenCode executable name/path. This value is server-owned and is
# never accepted from the browser or used as a participant ID.
# ALL_MY_FRIENDS_ARE_AGENTS_OPENCODE_COMMAND=/absolute/path/to/opencode
# Optional configured-default projections. They contain identifiers, never credentials.
# ALL_MY_FRIENDS_ARE_AGENTS_OPENCODE_PROVIDER=anthropic
# ALL_MY_FRIENDS_ARE_AGENTS_OPENCODE_MODEL=claude-sonnet

# Maximum simultaneous agent CLI processes for bulk actions (default: 3)
# ALL_MY_FRIENDS_ARE_AGENTS_AGENT_CONCURRENCY=3

# The bounded coordinator heartbeat is default-off. Both values are required,
# and the persisted runtime must then be explicitly authorized in Improvements.
# ALL_MY_FRIENDS_ARE_AGENTS_COORDINATOR_HEARTBEAT_ENABLED=true
# ALL_MY_FRIENDS_ARE_AGENTS_COORDINATOR_EXECUTOR_URL=https://executor.example.test/bounded-source-target
# ALL_MY_FRIENDS_ARE_AGENTS_COORDINATOR_MAX_SELECTED=5
# ALL_MY_FRIENDS_ARE_AGENTS_COORDINATOR_MAX_DISPATCHED=2
# ALL_MY_FRIENDS_ARE_AGENTS_COORDINATOR_MAX_ATTEMPTS=3
# ALL_MY_FRIENDS_ARE_AGENTS_COORDINATOR_TIME_BUDGET_MS=60000

# Durable per-agent continuations are default-off. Enabling this initial value
# still requires the visible persisted policy to remain enabled, an executor,
# and a developer member with CONTINUATION_RUN. The executor receives only the
# exact assignment workspace and ANALYZE/EDIT_ASSIGNMENT_WORKSPACE/RUN_TESTS.
# ALL_MY_FRIENDS_ARE_AGENTS_CONTINUATIONS_ENABLED=true
# ALL_MY_FRIENDS_ARE_AGENTS_CONTINUATION_EXECUTOR_URL=https://executor.example.test/v1/continuations
# ALL_MY_FRIENDS_ARE_AGENTS_CONTINUATION_EXECUTOR_TOKEN=

# Independent per-agent investigation lanes are default-off. They use a fresh
# provider session, local read-only capabilities, durable checkpoints, and a
# separate inbox. The global executor cap defaults to 2; each agent is capped at 1.
# ALL_MY_FRIENDS_ARE_AGENTS_INVESTIGATIONS_ENABLED=true
# ALL_MY_FRIENDS_ARE_AGENTS_INVESTIGATION_CONCURRENCY=2
# Optional initial policy default; 6000 when omitted, bounded to at most 96000.
# ALL_MY_FRIENDS_ARE_AGENTS_INVESTIGATION_DEFAULT_TOKEN_LIMIT=6000
# ALL_MY_FRIENDS_ARE_AGENTS_INVESTIGATION_EXECUTOR_URL=https://executor.example.test/v1/investigations
# ALL_MY_FRIENDS_ARE_AGENTS_INVESTIGATION_EXECUTOR_TOKEN=
