# Copy this file to .env.container. It is ignored by Git.
# Values here are passed into the application container; do not commit secrets.

# Use at least 32 random characters when the first operator is ready to claim
# the durable OWNER identity.
ALL_MY_FRIENDS_ARE_AGENTS_OWNER_BOOTSTRAP_SECRET=

# Optional server-side integration configuration. Keep credential values out of
# Compose files and public logs.
ALL_MY_FRIENDS_ARE_AGENTS_ALLOWED_HOSTS=
# For a protected reverse proxy, set the hostname without a scheme or port:
# ALL_MY_FRIENDS_ARE_AGENTS_ALLOWED_HOSTS=agents.example.test

# The GitHub App vault supports the newer repository integration. The legacy
# contribution broker separately requires BOTH of the following values; leave
# them empty to keep that write path disabled. Never reuse a read-only token.
ALL_MY_FRIENDS_ARE_AGENTS_GITHUB_REPOSITORY=
ALL_MY_FRIENDS_ARE_AGENTS_GITHUB_TOKEN=
ALL_MY_FRIENDS_ARE_AGENTS_GITHUB_READ_TOKEN=
