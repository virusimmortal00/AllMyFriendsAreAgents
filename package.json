{
  "name": "all-my-friends-are-agents",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,green \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "tsx watch server/index.ts",
    "dev:web": "vite",
    "build": "tsc -b && vite build",
    "logs:agents": "tsx scripts/review-agent-generations.ts",
    "start": "tsx server/index.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@vitejs/plugin-react": "5.0.4",
    "express": "5.1.0",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "vite": "7.3.6"
  },
  "devDependencies": {
    "@types/express": "5.0.3",
    "@types/node": "24.5.2",
    "@types/react": "19.1.16",
    "@types/react-dom": "19.1.9",
    "concurrently": "9.2.4",
    "tsx": "4.20.6",
    "typescript": "5.9.2",
    "vitest": "3.2.7"
  }
}
