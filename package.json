{
  "name": "all-my-friends-are-agents",
  "private": true,
  "version": "0.1.1",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,green \"pnpm run dev:server\" \"pnpm run dev:web\"",
    "dev:server": "ALL_MY_FRIENDS_ARE_AGENTS_PORT=${ALL_MY_FRIENDS_ARE_AGENTS_PORT:-53147} tsx watch server/index.ts",
    "dev:web": "vite",
    "format": "biome format --write .",
    "lint": "biome lint . --diagnostic-level=error",
    "typecheck": "tsc -b --force && pnpm run check:visual-types && tsc --project tsconfig.scripts.json && tsc --project tsconfig.strict-inventory.json && pnpm run check:type-coverage && pnpm run types:strict:inventory -- --assert-clean=all",
    "types:strict:inventory": "tsx scripts/strict-type-inventory.ts",
    "github:app:registration-url": "tsx scripts/github-app-registration.ts",
    "build": "pnpm run typecheck && vite build",
    "build:native-application": "tsx scripts/prepare-native-application.ts .runtime/native-production-app",
    "package:native-application": "tsx scripts/package-native-application.ts",
    "test:setup": "sh scripts/test-setup.sh",
    "preview:setup": "node scripts/preview-native-setup.mjs",
    "evidence:native-release": "tsx scripts/native-release-evidence.ts",
    "check:quality": "pnpm run lint && pnpm run check:integration-contracts && pnpm run check:api-contracts && pnpm run check:ui-standards && pnpm run build && pnpm test",
    "check:api-contracts": "tsx scripts/check-api-route-contracts.ts",
    "check:pr-size": "tsx scripts/check-pr-size.ts",
    "check:type-coverage": "tsx scripts/check-type-project-coverage.ts",
    "check:integration-contracts": "tsx scripts/check-integration-contracts.ts --run-tests",
    "check:opencode-binary": "tsx scripts/check-opencode-binary-contract.ts",
    "setup": "tsx scripts/setup-native-opencode.ts",
    "setup:opencode": "pnpm run setup",
    "auth": "tsx scripts/auth-native-opencode.ts",
    "check:ui-standards": "vitest run src/ui-standards.test.tsx src/layout-structure.test.tsx src/responsive-view-audit.test.ts src/reconnect-flow.test.tsx src/overlay.test.tsx src/chrome-safety.test.tsx src/mobile-layout.test.ts",
    "capture:visual": "tsx scripts/capture-visual.ts",
    "review:visual": "tsx scripts/review-visual.ts",
    "check:visual-review": "tsx scripts/check-visual-review.ts",
    "check:visual-types": "tsc --project tsconfig.visual.json",
    "canary:investigations": "tsx scripts/investigation-canary.ts",
    "canary:investigations:real": "tsx scripts/investigation-real-provider-canary.ts",
    "check:planning-docs": "tsx scripts/check-planning-doc-sync.ts",
    "control:owner": "tsx scripts/control-plane.ts",
    "control:owner:container": "node scripts/reset-container-owner.mjs",
    "logs:agents": "tsx scripts/review-agent-generations.ts",
    "room:tool": "tsx scripts/room-tool.ts",
    "service:start": "zsh scripts/run-application-service.zsh",
    "storage:import:sqlite": "tsx server/storage/import-json-to-sqlite.ts",
    "start": "tsx server/index.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@modelcontextprotocol/node": "2.0.0",
    "@modelcontextprotocol/server": "2.0.0",
    "@opencode-ai/plugin": "1.18.25",
    "@opencode-ai/sdk": "1.18.25",
    "@vitejs/plugin-react": "5.0.4",
    "express": "5.1.0",
    "pino": "10.3.1",
    "pino-roll": "4.0.0",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "vite": "7.3.6",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@modelcontextprotocol/client": "2.0.0",
    "@playwright/test": "1.62.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.5",
    "@types/express": "5.0.3",
    "@types/node": "24.5.2",
    "@types/react": "19.1.16",
    "@types/react-dom": "19.1.9",
    "concurrently": "9.2.4",
    "jsdom": "^30.0.1",
    "tsx": "4.20.6",
    "typescript": "5.9.2",
    "vitest": "3.2.7"
  }
}
