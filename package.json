{
  "name": "all-my-friends-are-agents",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,green \"pnpm run dev:server\" \"pnpm run dev:web\"",
    "dev:server": "ALL_MY_FRIENDS_ARE_AGENTS_PORT=${ALL_MY_FRIENDS_ARE_AGENTS_PORT:-53147} tsx watch server/index.ts",
    "dev:web": "vite",
    "github:app:registration-url": "tsx scripts/github-app-registration.ts",
    "build": "tsc -b --force && vite build",
    "check:quality": "pnpm run check:integration-contracts && pnpm run check:ui-standards && pnpm run check:visual-types && pnpm run build && pnpm test",
    "check:integration-contracts": "tsx scripts/check-integration-contracts.ts --run-tests",
    "check:opencode-binary": "tsx scripts/check-opencode-binary-contract.ts",
    "check:ui-standards": "vitest run src/ui-standards.test.tsx src/layout-structure.test.tsx src/responsive-view-audit.test.ts src/reconnect-flow.test.tsx src/overlay.test.tsx src/chrome-safety.test.tsx src/mobile-layout.test.ts",
    "capture:visual": "tsx scripts/capture-visual.ts",
    "review:visual": "tsx scripts/review-visual.ts",
    "check:visual-review": "tsx scripts/check-visual-review.ts",
    "check:visual-types": "tsc --project tsconfig.visual.json",
    "canary:investigations": "tsx scripts/investigation-canary.ts",
    "canary:investigations:real": "tsx scripts/investigation-real-provider-canary.ts",
    "check:planning-docs": "tsx scripts/check-planning-doc-sync.ts",
    "control:owner": "tsx scripts/control-plane.ts",
    "logs:agents": "tsx scripts/review-agent-generations.ts",
    "room:tool": "tsx scripts/room-tool.ts",
    "service:start": "zsh scripts/run-application-service.zsh",
    "storage:import:sqlite": "tsx server/storage/import-json-to-sqlite.ts",
    "start": "tsx server/index.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@modelcontextprotocol/node": "2.0.0",
    "@modelcontextprotocol/server": "2.0.0",
    "@opencode-ai/sdk": "1.18.25",
    "@vitejs/plugin-react": "5.0.4",
    "express": "5.1.0",
    "pino": "10.3.1",
    "pino-roll": "4.0.0",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "vite": "7.3.6",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.0.0",
    "@opencode-ai/plugin": "1.18.25",
    "@playwright/test": "1.62.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.5",
    "@types/express": "5.0.3",
    "@types/node": "24.5.2",
    "@types/react": "19.1.16",
    "@types/react-dom": "19.1.9",
    "concurrently": "9.2.4",
    "jsdom": "^30.0.1",
    "tsx": "4.20.6",
    "typescript": "5.9.2",
    "vitest": "3.2.7"
  }
}
